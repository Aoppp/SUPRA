# Copy to .env and fill in real values. .env is gitignored.
# Admin login password for the /admin dashboard and /upload management pages.
ADMIN_PASSWORD=change-me-to-something-strong

# JWT signing secret. If unset, restarting the backend invalidates all tokens.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated allowed CORS origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
